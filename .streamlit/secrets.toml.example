# Copy these keys into Streamlit Community Cloud's app Secrets settings.
# In Supabase, choose Connect -> Session pooler and replace the placeholders.
DATABASE_URL = "postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
SECRET_KEY = "replace-with-a-long-random-secret"
JWT_SECRET_KEY = "replace-with-a-different-long-random-secret"

AI_PROVIDER = "mock"
# Optional PayPal Sandbox setup. Set RETURN/CANCEL URLs to your deployed app URL.
PAYPAL_CLIENT_ID = ""
PAYPAL_CLIENT_SECRET = ""
PAYPAL_BASE_URL = "https://api-m.sandbox.paypal.com"
PAYPAL_RETURN_URL = "https://YOUR-APP.streamlit.app"
PAYPAL_CANCEL_URL = "https://YOUR-APP.streamlit.app"
